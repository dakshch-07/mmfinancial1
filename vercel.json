{
  "version": 2,
  "name": "mm-financial-demo",
  "cleanUrls": true,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/calculators/?$",
      "dest": "/calculators/index.html"
    },
    {
      "src": "^/calculators/([a-zA-Z0-9_-]+)/?$",
      "dest": "/calculators/$1.html"
    },
    {
      "src": "^/loans(\\.html)?/?$",
      "dest": "/loans.html"
    },
    {
      "src": "^/mutual-funds(\\.html)?/?$",
      "dest": "/mutual-funds.html"
    },
    {
      "src": "^/insurance(\\.html)?/?$",
      "dest": "/insurance.html"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
