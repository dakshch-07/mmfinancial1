RewriteEngine On

# Allow direct file access
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean URL for Calculators Hub
RewriteRule ^calculators/?$ calculators/index.html [L]

# Clean URL for Individual Calculators
RewriteRule ^calculators/([a-zA-Z0-9_-]+)/?$ calculators/$1.html [L]
